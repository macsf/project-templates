# Production / Docker. Copy to `.env` on the host or set the same names in
# Hostinger / Dokploy / Coolify. Do not commit real values.
#
# Local Next.js dev uses `.env.local` (see `.env.local.example`).

NODE_ENV=production

# SQLite in the container:
DATABASE_URL=file:/data/app.db
# MySQL (external; never localhost from inside the container):
# DATABASE_URL=mysql://user:password@db-host:3306/{{PROJECT_NAME}}

NEXTAUTH_URL=https://example.com
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Access control (leave empty to allow all authenticated Google users)
ALLOWED_GOOGLE_DOMAIN=
ALLOWED_USERS=
