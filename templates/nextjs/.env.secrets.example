# GitHub environment SECRETS (Settings > Environments > deploy > Secrets)
# Credentials and personal data. Never commit real values.
#
# Import:
#   cp .env.secrets.example /tmp/{{PROJECT_NAME}}.secrets   # fill in real values, drop blank lines
#   gh secret set -f /tmp/{{PROJECT_NAME}}.secrets --env deploy --repo <owner>/{{PROJECT_NAME}}
#   rm /tmp/{{PROJECT_NAME}}.secrets
#
# Local: copy to `.env.secrets`, fill in, then `pnpm env:merge`

# Hostinger API token (deploy action)
HOSTINGER_API_KEY=

# Database (Prisma). Docker SQLite: file:/data/app.db
# MySQL: never localhost from inside a container.
DATABASE_URL={{DATABASE_URL}}
# SHADOW_DATABASE_URL=mysql://root:password@127.0.0.1:3306/{{PROJECT_NAME}}_shadow

# NextAuth JWT secret. Generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Google OAuth client secret (client id lives in .env.vars.example)
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts that may sign in. Leave blank to allow all.
ALLOWED_USERS=
