# GitHub environment VARIABLES (Settings > Environments > deploy > Variables)
# Non-sensitive config. Safe to read in logs. Blank values fall back to workflow defaults.
#
# Import:
#   cp .env.vars.example /tmp/{{PROJECT_NAME}}.vars   # fill in real values, drop blank lines
#   gh variable set -f /tmp/{{PROJECT_NAME}}.vars --env deploy --repo <owner>/{{PROJECT_NAME}}
#   rm /tmp/{{PROJECT_NAME}}.vars
#
# Local: copy to `.env.vars`, fill in, then `pnpm env:merge`

# Hostinger VPS id (numeric part of srvNNNNNN)
HOSTINGER_VM_ID=

# Traefik routing
TRAEFIK_HOST=example.com
TRAEFIK_ROUTER={{PROJECT_NAME}}
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENABLE=false

# Local Express listen port. Hostinger GitHub import: unique VPS loopback port
# (container still listens on 8080).
PORT={{API_PORT}}
HOST_UID=0
HOST_GID=0

# Frontend (Vite). In Docker, VITE_* are build-args; use VITE_API_BASE_URL=/api.
VITE_API_BASE_URL=http://localhost:{{API_PORT}}
VITE_GOOGLE_CLIENT_ID=

# Public origin (no trailing slash). Production deploy sets this from TRAEFIK_HOST.
FRONTEND_URL=http://localhost:{{APP_PORT}}

# Google OAuth client id (the secret lives in .env.secrets.example)
GOOGLE_CLIENT_ID=

# Local only. Omit from GitHub import. Never true in production.
DEV_BYPASS_AUTH=true
DEV_USER_EMAIL=dev@local.test
DEV_USER_NAME=Dev User
